+bool MacReferenceWindowOutput() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("FM4_REFERENCE_WINDOW_OUTPUT");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  return enabled;
+}
+
+float MacWindowHeadroom(uint32_t window_properties) {
+  if (!window_properties) return 1.0f;
+  // SDL Cocoa supplies current headroom (potential during EDR startup).
+  const float limit = SDL_GetFloatProperty(window_properties, SDL_PROP_WINDOW_HDR_HEADROOM_FLOAT, 1.0f);
+  return std::isfinite(limit) && limit > 1.0f ? limit : 1.0f;
+}
