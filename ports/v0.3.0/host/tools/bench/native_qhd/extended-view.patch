+float ViewFactor(unsigned w, unsigned h) {
+  if (!w || !h) return 1.0f;
+  const float f = (float(w) / float(h)) / (16.0f / 9.0f);
+  return f >= 1.0f / 1.01f && f <= 1.01f ? 1.0f : std::clamp(f, .75f, 2.0f);
