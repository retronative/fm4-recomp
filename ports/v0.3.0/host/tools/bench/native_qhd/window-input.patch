+// The FM4 Recomp parent owns the Dock icon and explicitly starts this child
+// as an SDL background app. Promote only its actual game window to accessory.
+bool IsFm4AccessoryGame() {
+  static const bool enabled = [] {
+    const char* mode = std::getenv("FM4_REFERENCE_WINDOW_OUTPUT");
+    return mode && std::strcmp(mode, "1") == 0 &&
+           SDL_GetHintBoolean(SDL_HINT_MAC_BACKGROUND_APP, false);
+  }();
+  return enabled;
+}
+
+void ActivateFm4Accessory() {
+  const id app = reinterpret_cast<id (*)(id, SEL)>(objc_msgSend)(
+      reinterpret_cast<id>(objc_getClass("NSApplication")), sel_registerName("sharedApplication"));
+  reinterpret_cast<bool (*)(id, SEL, long)>(objc_msgSend)(
+      app, sel_registerName("setActivationPolicy:"), 1L);  // NSApplicationActivationPolicyAccessory
+  reinterpret_cast<void (*)(id, SEL, bool)>(objc_msgSend)(
+      app, sel_registerName("activateIgnoringOtherApps:"), true);
+}
