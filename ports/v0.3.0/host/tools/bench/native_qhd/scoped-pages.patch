+bool TextureCache::AddDrawTexturePageRanges(uint32_t used_texture_mask,
+                                            DrawPageRanges& ranges) const {
+  const auto& regs = register_file();
+  uint32_t slot;
+  while (rex::bit_scan_forward(used_texture_mask, &slot)) {
+    const uint32_t bit = UINT32_C(1) << slot;
+    used_texture_mask &= ~bit;
+    const auto& binding = texture_bindings_[slot];
+    const uint32_t* words = &regs.values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + slot * 6];
+
+    const TextureKey* logical_key = nullptr;
+    const Texture* texture = nullptr;
+    const Texture* signed_texture = nullptr;
+    if (binding.fetch_words_valid &&
+        ((texture_bindings_in_sync_ & bit) ||
+         !std::memcmp(binding.fetch_words, words, sizeof(binding.fetch_words)))) {
+      logical_key = &binding.key;
+      texture = binding.texture;
+      signed_texture = binding.texture_signed;
+    } else {
+      const BindingMemo& memo = binding_memos_[BindingMemoSlot(words)];
+      if (memo.epoch == binding_memo_epoch_ &&
+          !std::memcmp(memo.fetch_words, words, sizeof(memo.fetch_words))) {
+        logical_key = &memo.key;
+        texture = memo.texture;
+        signed_texture = memo.texture_signed;
+      }
+    }
+
+    auto add_footprint = [&](const TextureKey& key, uint32_t base_bytes, uint32_t mip_bytes) {
+      return (base_bytes || mip_bytes) &&
+             (!base_bytes || (key.base_page && ranges.Add(key.base_page << 12, base_bytes))) &&
+             (!mip_bytes || (key.mip_page && ranges.Add(key.mip_page << 12, mip_bytes)));
+    };
+    if (logical_key) {
+      if (!logical_key->is_valid || (!texture && !signed_texture) ||
+          logical_key->dimension == xenos::DataDimension::k3D) {
+        return false;
+      }
+      for (const Texture* backing : {texture, signed_texture}) {
+        if (!backing) continue;
+        const TextureKey& key = backing->key();
+        // A mip rebased to satisfy a device limit has a different footprint.
+        if (key.base_page != logical_key->base_page || key.mip_page != logical_key->mip_page ||
+            !add_footprint(key, backing->GetGuestBaseSize(), backing->GetGuestMipsSize())) {
+          return false;
+        }
+      }
+      continue;
+    }
+
+    // A previously unseen fetch has no host object yet. Only derive the
+    // canonical guest layout for ordinary 2D/cube inputs. This bound keeps
+    // the layout's 32-bit extent arithmetic safe even for 16-byte texels.
+    const auto fetch = regs.GetTextureFetch(slot);
+    if (fetch.type != xenos::FetchConstantType::kTexture ||
+        (fetch.dimension != xenos::DataDimension::k2DOrStacked &&
+         fetch.dimension != xenos::DataDimension::kCube)) {
+      return false;
+    }
+    TextureKey key;
+    BindingInfoFromFetchConstant(fetch, key, nullptr);
+    if (!key.is_valid || !key.pitch || key.GetWidth() > 2048 || key.GetHeight() > 2048 ||
+        (key.pitch << 5) > 2048 || key.GetDepthOrArraySize() > 6) {
+      return false;
+    }
+    const uint32_t block_bytes = FormatInfo::Get(key.format)->bytes_per_block();
+    if (!block_bytes || block_bytes > 16 || (block_bytes & (block_bytes - 1))) {
+      return false;
+    }
+    // FindOrCreateTexture drops scaling before rebasing. If the unscaled
+    // extent fits, both possible owners and signs use this same guest layout.
+    const uint32_t max_size = GetMaxHostTextureWidthHeight(key.dimension);
+    if (key.GetWidth() > max_size || key.GetHeight() > max_size ||
+        key.GetDepthOrArraySize() > GetMaxHostTextureDepthOrArraySize(key.dimension)) {
+      return false;
+    }
+    const auto layout = key.GetGuestLayout();
+    if (!add_footprint(key, layout.base.level_data_extent_bytes, layout.mips_total_extent_bytes)) {
+      return false;
+    }
+  }
+  return true;
+}
