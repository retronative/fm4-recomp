+bool CollectDrawPageRanges(const RegisterFile& regs, const VulkanShader* vertex_shader,
+                           const VulkanShader* pixel_shader, const VulkanTextureCache& textures,
+                           DrawPageRanges& ranges) {
+  const auto edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (!vertex_shader ||
+      (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly)) {
+    return false;
+  }
+  if (edram_mode == xenos::EdramMode::kDepthOnly) pixel_shader = nullptr;
+
+  uint32_t texture_mask = 0;
+  for (const VulkanShader* shader : {vertex_shader, pixel_shader}) {
+    if (!shader) continue;
+    uint32_t stage_mask;
+    if (!shader->TryGetUsedTextureMask(stage_mask) || !shader->is_ucode_analyzed() ||
+        shader->memexport_eM_written()) {
+      return false;
+    }
+    texture_mask |= stage_mask;
+    const auto& fetch_bits = shader->constant_register_map().vertex_fetch_bitmap;
+    for (uint32_t word = 0; word < rex::countof(fetch_bits); ++word) {
+      uint32_t bits = fetch_bits[word];
+      uint32_t bit;
+      while (rex::bit_scan_forward(bits, &bit)) {
+        bits &= bits - 1;
+        const auto fetch = regs.GetVertexFetch(word * 32 + bit);
+        if (fetch.type != xenos::FetchConstantType::kVertex ||
+            !ranges.Add(uint32_t(fetch.address) << 2, uint32_t(fetch.size) << 2)) {
+          return false;
+        }
+      }
+    }
+  }
+
+  // Match PrimitiveProcessor::Process before it consults converted indices.
+  const auto draw = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (draw.source_select == xenos::SourceSelect::kDMA) {
+    const uint32_t stride = draw.index_size == xenos::IndexFormat::kInt16 ? 2 : 4;
+    const uint32_t count =
+        std::min<uint32_t>(draw.num_indices, regs.Get<reg::VGT_DMA_SIZE>().num_words);
+    const uint32_t base = regs[XE_GPU_REG_VGT_DMA_BASE] & ~(stride - 1);
+    if (!ranges.Add(base, count * stride)) return false;
+  } else if (draw.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  return textures.AddDrawTexturePageRanges(texture_mask, ranges);
+}
 
