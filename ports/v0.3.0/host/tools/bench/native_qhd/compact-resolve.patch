+bool VulkanTextureCache::EnsureCompactScaledResolveRange(uint64_t start, uint64_t length) {
+  if (!length || compact_resolve_size_ == scaled_resolve_buffer_size_) return true;
+  uint64_t local;
+  const uint64_t bank_size = ScaledResolveBanks::BankSize(draw_resolution_scale_x());
+  if (scaled_resolve_buffer_ && compact_resolve_banks_.Translate(start, length, local, bank_size)) {
+    return true;
+  }
+  const uint32_t capacity = uint32_t(compact_resolve_capacity_ / bank_size);
+  auto next = compact_resolve_banks_;
+  if (!next.Reserve(start, length, capacity, bank_size)) return AllocateCompactResolveBacking(true);
+  if (!scaled_resolve_buffer_ && !AllocateCompactResolveBacking(false)) return false;
+  compact_resolve_banks_ = next;
+  return true;
+}
