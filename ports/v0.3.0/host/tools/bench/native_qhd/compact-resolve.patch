+bool VulkanTextureCache::CommitScaledResolveDestination(uint32_t base, uint32_t extent_start,
+                                                        uint32_t extent_length,
+                                                        uint32_t alignment_log2) {
+  const uint64_t end = uint64_t(extent_start) + extent_length;
+  if (extent_start < base || end > SharedMemory::kBufferSize) return false;
+  uint64_t logical_base, base_length, logical_use, use_length;
+  if (!GetScaledResolveLogicalRange(base, uint32_t(end - base), alignment_log2, logical_base,
+                                    base_length) ||
+      !GetScaledResolveLogicalRange(extent_start, extent_length, alignment_log2, logical_use,
+                                    use_length)) return false;
+  // Independent alignment of the written length may reach past the enclosing
+  // descriptor's rounded end. Reserve the union with a single bank assignment.
+  const uint64_t union_length =
+      std::max(logical_base + base_length, logical_use + use_length) - logical_base;
+  if (compact_resolve_capacity_) return EnsureCompactScaledResolveRange(logical_base, union_length);
+  return EnsureScaledResolveBufferAllocated(logical_base, union_length);
+}
