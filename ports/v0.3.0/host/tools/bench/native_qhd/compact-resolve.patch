+namespace {
+uint64_t CompactResolveBudget(uint32_t scale) {
+  if (scale != 2 && scale != 3) return 0;
+  const char* begin = std::getenv(scale == 3 ? "FM4_SHIFTGLUE_4K_RESOLVE_MIB"
+                                            : "FM4_SHIFTGLUE_RESOLVE_MIB");
+  if (!begin || !*begin) return 0;
+  const char* end = begin + std::strlen(begin);
+  uint32_t mib;
+  const auto parsed = std::from_chars(begin, end, mib);
+  const uint64_t bank_mib = ScaledResolveBanks::BankSize(scale) >> 20;
+  if (parsed.ec != std::errc{} || parsed.ptr != end || !mib ||
+      mib >= ScaledResolveBanks::kCount * bank_mib || mib % bank_mib) {
+    return 0;
+  }
+  return uint64_t(mib) << 20;
+}
+}  // namespace
+
+bool VulkanTextureCache::NeedsCompactSwitchPreflight(uint32_t next_scale) const {
+  return compact_resolve_capacity_ || CompactResolveBudget(next_scale);
+}
