+bool VulkanTextureCache::AllocateCompactResolveBacking(bool dense) {
+  assert_true(compact_resolve_capacity_ != 0);
+  const uint64_t size = dense ? scaled_resolve_buffer_size_ : compact_resolve_capacity_;
+  if (scaled_resolve_buffer_ && !command_processor_.submission_open()) {
+    REXGPU_ERROR("Cannot promote scaled resolve storage outside an open submission");
+    return false;
+  }
+  const auto* device = command_processor_.GetVulkanDevice();
+  constexpr VkBufferUsageFlags kUsage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                                        VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                                        VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+  VkBuffer next_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory next_memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          device, size, kUsage, ui::vulkan::util::MemoryPurpose::kDeviceLocal, next_buffer,
+          next_memory)) {
+    REXGPU_ERROR("Could not allocate {} MiB of scaled resolve storage", size >> 20);
+    return false;
+  }
+
+  if (scaled_resolve_buffer_) {
+    assert_true(dense && !retired_compact_buffer_);
+    // Previously submitted descriptors retain the old handle until this copy
+    // completes. All commands are recorded on the same ordered graphics queue.
+    command_processor_.PushBufferMemoryBarrier(
+        scaled_resolve_buffer_, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+    command_processor_.SubmitBarriers(true);
+    const uint64_t bank_size = ScaledResolveBanks::BankSize(draw_resolution_scale_x());
+    std::array<VkBufferCopy, ScaledResolveBanks::kCount> copies;
+    uint32_t count = 0;
+    for (uint32_t bank = 0; bank < ScaledResolveBanks::kCount; ++bank) {
+      const int slot = compact_resolve_banks_.slot(bank);
+      if (slot >= 0) {
+        copies[count++] = {uint64_t(slot) * bank_size, uint64_t(bank) * bank_size, bank_size};
+      }
+    }
+    if (count) {
+      command_processor_.deferred_command_buffer().CmdVkCopyBuffer(scaled_resolve_buffer_,
+                                                                  next_buffer, count, copies.data());
+      command_processor_.PushBufferMemoryBarrier(
+          next_buffer, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+          VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+          VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT, VK_QUEUE_FAMILY_IGNORED,
+          VK_QUEUE_FAMILY_IGNORED, false);
+      command_processor_.SubmitBarriers(true);
+    }
+    retired_compact_buffer_ = scaled_resolve_buffer_;
+    retired_compact_memory_ = scaled_resolve_buffer_memory_.front();
+    retired_compact_size_ = compact_resolve_size_;
+    retired_compact_submission_ = command_processor_.GetCurrentSubmission();
+    scaled_resolve_last_usage_write_ = false;
+    scaled_resolve_last_written_range_ = {0, 0};
+    REXGPU_INFO("Promoted {}x resolve storage from {} to {} MiB, copied {} banks",
+                draw_resolution_scale_x(), compact_resolve_size_ >> 20, size >> 20, count);
+  } else {
+    REXGPU_INFO("Allocated {} MiB of {} {}x resolve storage", size >> 20,
+                dense ? "dense" : "banked", draw_resolution_scale_x());
+  }
+  scaled_resolve_buffer_memory_.assign(1, next_memory);
+  scaled_resolve_buffer_ = next_buffer;
+  compact_resolve_size_ = size;
   return true;
 }
 
