+      device, load_pipeline_layout_, shaders::fh1_scaled_resolve_rescale_cs,
+      sizeof(shaders::fh1_scaled_resolve_rescale_cs));
+  return rescale_pipeline_ != VK_NULL_HANDLE;
+}
