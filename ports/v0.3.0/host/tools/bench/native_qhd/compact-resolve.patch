+bool VulkanTextureCache::PrepareCompactSwitch(VulkanTextureCache& previous) {
+  // Called after queue idle with the old renderer still installed. A failure
+  // here may discard only this unused candidate cache, never valid guest data.
+  const auto runs = previous.GetScaledResolveRuns();
+  if (runs.empty()) return true;
+  if (!previous.scaled_resolve_buffer_) return false;
+  ScaledResolveBanks prepared;
+  bool dense = false;
+  const uint32_t dest_scale = draw_resolution_scale_x();
+  const uint64_t area = uint64_t(dest_scale) * dest_scale;
+  const uint64_t bank_size = ScaledResolveBanks::BankSize(dest_scale);
+  const uint32_t banks = uint32_t(compact_resolve_capacity_ / bank_size);
+  for (const auto& run : runs) {
+    for (uint32_t offset = 0; offset < run.length;) {
+      const uint32_t start = run.start + offset;
+      const uint32_t guest_bank_remaining =
+          ScaledResolveBanks::kGuestSize - start % ScaledResolveBanks::kGuestSize;
+      const uint32_t length = std::min(run.length - offset, guest_bank_remaining);
+      uint64_t source_start, source_length;
+      if (!previous.GetScaledResolveRange(start, length, 0, source_start, source_length)) {
+        return false;
+      }
+      if (banks && !dense &&
+          !prepared.Reserve(uint64_t(start) * area, uint64_t(length) * area, banks, bank_size)) {
+        dense = true;
+      }
+      offset += length;
+    }
