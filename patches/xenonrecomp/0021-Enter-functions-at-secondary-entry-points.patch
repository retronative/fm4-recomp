+
     out += tempString;
 
     return allRecompiled;
@@ -3152,6 +3239,8 @@ void Recompiler::Recompile(const std::filesystem::path& headerFilePath)
             const auto source = functionSources.find(fn.base);
             println("{:08X} {:X} {}", fn.base, fn.size, source != functionSources.end() ? source->second : "unknown");
         }
+        for (const auto& [entry, owner] : secondaryEntries)
+            println("{:08X} 0 secondary@{:08X}", entry, owner);
         SaveCurrentOutData("ppc_functions.txt");
     }
 
@@ -3169,6 +3258,13 @@ void Recompiler::Recompile(const std::filesystem::path& headerFilePath)
         Recompile(functions[i]);
     }
 
+    for (const auto& [entry, owner] : secondaryEntries)
+    {
+        const auto fn = std::find_if(functions.begin(), functions.end(), [&](const Function& f) { return f.base == owner; });
