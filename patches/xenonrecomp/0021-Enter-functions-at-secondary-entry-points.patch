@@ -526,6 +598,15 @@ bool Recompiler::Recompile(
                         println("\t{}(ctx, base);", targetSymbol->name);
                     }
                 }
+                else if (std::any_of(image.sections.begin(), image.sections.end(), [&](const Section& s)
+                    { return (s.flags & SectionFlags_Code) && address >= s.base && address + 4 <= s.base + s.size; }) &&
+                    *reinterpret_cast<const uint32_t*>(image.Find(address)) == 0)
+                {
+                    // The target is a zero word of a code section outside any function: an
+                    // illegal instruction.
