-    auto symbol = image.symbols.find(fn.base);
+    auto symbol = image.symbols.find(entry != 0 ? entry : fn.base);
     std::string name;
     if (symbol != image.symbols.end())
     {
@@ -3038,6 +3121,10 @@ bool Recompiler::Recompile(const Function& fn)
     if (localVariables.ea)
         println("\tuint32_t ea{{}};");
 
+    // A secondary entry starts at its label, after the declarations (C++ cannot jump past them).
