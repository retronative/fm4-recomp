+                    fmt::println("NOTE: branch target {:X} from {:X} is a zero word", address, base);
+                }
                 else
                 {
                     Fatal(fmt::format("branch target {:X} from {:X} is not a function", address, base));
@@ -2771,7 +2852,7 @@ bool Recompiler::Recompile(
