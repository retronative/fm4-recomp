@@ -331,7 +338,9 @@ void Recompiler::Analyse()
             {
                 size_t address = base + (data - section.data) + PPC_BI(insn);
 
-                if (address >= section.base && address < section.base + section.size && image.symbols.find(address) == image.symbols.end())
+                const auto after = std::upper_bound(known.begin(), known.end(), std::pair<size_t, size_t>(address, SIZE_MAX));
+                const bool inside = after != known.begin() && address > std::prev(after)->first && address < std::prev(after)->second;
+                if (address >= section.base && address < section.base + section.size && image.symbols.find(address) == image.symbols.end() && !inside)
                 {
                     auto data = section.data + address - section.base;
                     auto& fn = functions.emplace_back(Function::Analyze(data, section.base + section.size - address, address));
@@ -370,7 +379,12 @@ void Recompiler::Analyse()
             }
             else
             {
-                auto& fn = functions.emplace_back(Function::Analyze(data, dataEnd - data, base));
+                // Never run over the next known function: what follows is its code, not this one's.
+                auto next = image.symbols.lower_bound(base + 1);
+                while (next != image.symbols.end() && next->type != Symbol_Function)
+                    ++next;
+                const size_t limit = next != image.symbols.end() ? std::min<size_t>(dataEnd - data, next->address - base) : dataEnd - data;
+                auto& fn = functions.emplace_back(Function::Analyze(data, limit, base));
                 functionSources.emplace(fn.base, "sweep");
                 image.symbols.emplace(fmt::format("sub_{:X}", fn.base), fn.base, fn.size, Symbol_Function);
 
@@ -381,6 +395,64 @@ void Recompiler::Analyse()
     }
 
     std::sort(functions.begin(), functions.end(), [](auto& lhs, auto& rhs) { return lhs.base < rhs.base; });
+
+    // A function found by analysis (not declared by .pdata, the config or the helpers) ends where
+    // the next function starts: analysis follows branches, and a tail branch into the next
+    // function must not absorb it. Branches past the cut become tail calls or secondary entries.
+    for (size_t i = 0; i + 1 < functions.size(); i++)
+    {
+        auto& fn = functions[i];
+        const auto source = functionSources.find(fn.base);
+        const bool analysed = source != functionSources.end() &&
+            (source->second == "bl_target" || source->second == "sweep" || source->second == "export");
+        if (analysed && fn.base + fn.size > functions[i + 1].base && functions[i + 1].base > fn.base)
+            fn.size = functions[i + 1].base - fn.base;
+    }
+
+    FindSecondaryEntries();
+}
+
+void Recompiler::FindSecondaryEntries()
+{
+    // A direct branch or call to an address inside another function enters that function's body
+    // there: MSVC shares tails between functions (and calls some of them), and code without .pdata
+    // is split into several functions that branch into each other. Each such target becomes a secondary entry,
+    // emitted as the containing function's body entered at the target.
+    const auto containing = [&](uint32_t address) -> const Function*
+        {
+            auto it = std::upper_bound(functions.begin(), functions.end(), address, [](uint32_t a, const Function& f) { return a < f.base; });
+            for (int back = 0; it != functions.begin() && back < 64; back++)
+            {
+                --it;
+                if (address > it->base && address < it->base + it->size)
+                    return &*it;
+            }
+            return nullptr;
+        };
+    for (const auto& fn : functions)
+    {
+        for (uint32_t address = uint32_t(fn.base); address < fn.base + fn.size; address += 4)
+        {
+            const auto* word = reinterpret_cast<const uint32_t*>(image.Find(address));
+            const uint32_t insn = word ? ByteSwap(*word) : 0;
+            const uint32_t op = PPC_OP(insn);
+            if ((op != PPC_OP_B && op != PPC_OP_BC) || dataRanges.count(address))
+                continue;
+            const uint32_t displacement = op == PPC_OP_B ? PPC_BI(insn) : PPC_BD(insn);
+            const uint32_t target = (insn & 2) ? displacement : address + displacement;
+            if (target >= fn.base && target < fn.base + fn.size)
+                continue;
+            if (image.symbols.find(target) != image.symbols.end())
+                continue;
+            if (const auto* owner = containing(target))
+                secondaryEntries.emplace(target, uint32_t(owner->base));
+        }
+    }
+    for (const auto& [entry, owner] : secondaryEntries)
+    {
+        const auto* fn = containing(entry);
+        image.symbols.emplace(fmt::format("sub_{:X}", entry), entry, uint32_t(fn->base + fn->size - entry), Symbol_Function);
+    }
 }
 
