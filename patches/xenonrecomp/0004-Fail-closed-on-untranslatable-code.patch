+// True when execution never continues at the next word (b, blr, bctr, an always-taken bc, or an
+// always-trapping tw/twi).
+static bool IsUnconditionalTerminator(uint32_t insn)
+{
+    const uint32_t op = insn >> 26, bo = (insn >> 21) & 31, xop = (insn >> 1) & 0x3FF;
+    const bool link = insn & 1, always = (bo & 0x14) == 0x14;
+    if (op == 18) return !link;
+    if (op == 16) return !link && always;
+    if (op == 19 && (xop == 16 || xop == 528)) return !link && always;
+    if (op == 31 && xop == 4) return ((insn >> 21) & 31) == 31;
+    if (op == 2 || op == 3) return ((insn >> 21) & 31) == 31;
+    return false;
+}
+
+// Name of the PPCCRRegister field for condition-register bit `bi` (0-31).
+static const char* CrBit(uint32_t bi)
+{
+    static const char* const names[] = { "lt", "gt", "eq", "so" };
+    return names[bi % 4];
+}
+
+// Targets of "goto loc_X;" in a function body that the body never defines as "loc_X:".
+static std::vector<uint32_t> UndefinedLabels(std::string_view body)
+{
+    std::set<uint32_t> defined, used;
+    for (size_t at = body.find("loc_"); at != std::string_view::npos; at = body.find("loc_", at))
+    {
+        const bool isGoto = at >= 5 && body.substr(at - 5, 5) == "goto ";
+        at += 4;
+        size_t end = at;
+        while (end < body.size() && std::isxdigit(static_cast<unsigned char>(body[end]))) ++end;
+        if (end == at) continue;
+        const uint32_t label = uint32_t(std::stoul(std::string(body.substr(at, end - at)), nullptr, 16));
+        if (isGoto) used.insert(label);
+        else if (end < body.size() && body[end] == ':') defined.insert(label);
+        at = end;
+    }
+    std::vector<uint32_t> missing;
+    for (uint32_t label : used)
+        if (!defined.count(label)) missing.push_back(label);
+    return missing;
+}
