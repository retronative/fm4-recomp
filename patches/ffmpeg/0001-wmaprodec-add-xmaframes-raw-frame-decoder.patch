+/* xmaframes: one XMA frame per packet, the packet parsing done by the caller (Xenia's XMA context). Ported from
+ * xenia-canary/FFmpeg_radixsplit 244cc2f281 "avcodec/wmaprodec: add xma raw frame decoder" to FFmpeg 7.1.1's codec
+ * API (FFCodec, AVFrame output, ch_layout); the decoding steps are unchanged. */
+static av_cold int xmaframes_decode_init(AVCodecContext *avctx)
+{
+    WMAProDecodeCtx *s = avctx->priv_data;
+
+    return decode_init(s, avctx, 0);
+}
+
+static av_cold int xmaframes_decode_end(AVCodecContext *avctx)
+{
+    WMAProDecodeCtx *s = avctx->priv_data;
+
+    decode_end(s);
+
+    return 0;
+}
+
+/**
+ *@brief Decode a single XMA frame. The packet holds one byte of bit padding sizes (3 bits before the frame, 3 bits
+ *       after it, 2 unused) and then the frame, padded to whole bytes.
+ *@return number of bytes read from the packet
+ */
+static int xmaframes_decode_packet(AVCodecContext *avctx, AVFrame *frame,
+                                   int *got_frame_ptr, AVPacket *avpkt)
+{
+    WMAProDecodeCtx *s = avctx->priv_data;
+    GetBitContext *gb = &s->gb;
+    int ret, xma_frame_len;
+    int padding_start, padding_end;
+
+    if (avpkt->size < 3) {
+        av_log(avctx, AV_LOG_ERROR, "XMA frame is too small, %d bytes\n", avpkt->size);
+        return AVERROR_INVALIDDATA;
+    }
+
+    s->buf_bit_size = avpkt->size << 3;
+    ret = init_get_bits(gb, avpkt->data, s->buf_bit_size);
+    if (ret < 0)
+        return ret;
+
+    padding_start = get_bits(gb, 3);
+    padding_end   = get_bits(gb, 3);
+    skip_bits(gb, 2);
+    skip_bits(gb, padding_start);
+
+    xma_frame_len = show_bits(gb, s->log2_frame_size);
+    if (s->buf_bit_size != 8 + padding_start + xma_frame_len + padding_end) {
+        av_log(avctx, AV_LOG_ERROR, "XMA frame sizing incorrect: %d != 8 + %d + %d + %d\n",
+               s->buf_bit_size, padding_start, xma_frame_len, padding_end);
+        return AVERROR_INVALIDDATA;
+    }
+
+    save_bits(s, gb, xma_frame_len, 0);
+
+    frame->nb_samples = s->samples_per_frame;
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0) {
+        s->packet_loss = 1;
+        return 0;
+    }
+
+    decode_frame(s, frame, got_frame_ptr);
+
+    return avpkt->size;
+}
+
 static av_cold int xma_decode_end(AVCodecContext *avctx)
 {
     XMADecodeCtx *s = avctx->priv_data;
@@ -2146,6 +2219,21 @@
                       AV_CODEC_CAP_SUBFRAMES |
 #endif
                       AV_CODEC_CAP_DR1 | AV_CODEC_CAP_DELAY,
+    .p.sample_fmts  = (const enum AVSampleFormat[]) { AV_SAMPLE_FMT_FLTP,
+                                                      AV_SAMPLE_FMT_NONE },
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+};
